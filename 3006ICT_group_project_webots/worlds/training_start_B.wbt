WorldInfo {
  title "3006ICT Training Start B"
  info [
    "3006ICT Group Project final environment"
    "B1-B5: four different non-target images on four vertical faces"
    "4 boundary + 4 interior observation stations"
    "Webots Camera Recognition ground truth is not used"
  ]
}

